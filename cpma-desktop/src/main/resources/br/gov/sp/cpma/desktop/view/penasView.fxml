<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.PenasController">
    <content>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <VBox spacing="16.0" styleClass="card-container">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblTituloForm" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #2563eb;" text="Lancar Nova Pena Alternativa" />
                        <Label fx:id="lblSubtituloForm" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Vincule o apenado a uma instituicao parceira e defina os termos e contrato de cumprimento." />
                    </VBox>
                    <Button fx:id="btnCancelarEdicao" onAction="#handleCancelarEdicao" text="✖ Cancelar Edição" visible="false" managed="false" style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6px; -fx-padding: 6px 14px;" />
                </HBox>

                <Label fx:id="lblFeedback" maxWidth="Infinity" visible="false" wrapText="true" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="CPF do Apenado *" />
                        <HBox spacing="8.0">
                            <TextField fx:id="txtCpfApenado" promptText="000.000.000-00" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnBuscarApenado" onAction="#handleBuscarApenado" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand;" text="Localizar Apenado" />
                        </HBox>
                        <Label fx:id="lblCpfError" />
                    </VBox>
                </HBox>

                <HBox fx:id="boxApenadoEncontrado" alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f1f5f9; -fx-padding: 10px 14px; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;" visible="false" managed="false">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #059669;" text="Apenado Selecionado:" />
                    <Label fx:id="lblNomeApenado" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="---" />
                </HBox>

                <GridPane hgap="16.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Instituicao Parceira Principal *" />
                        <ComboBox fx:id="cbInstituicao" maxWidth="Infinity" promptText="Selecione a instituicao parceira..." />
                        <Label fx:id="lblInstituicaoError" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Tipo de Medida Alternativa *" />
                        <HBox spacing="8.0">
                            <ComboBox fx:id="cbTipoPena" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" promptText="Selecione ou digite o tipo..." />
                            <Button onAction="#handleNovoTipoPena" styleClass="btn-secondary" text="➕ Novo Tipo" style="-fx-font-size: 12px; -fx-padding: 6px 12px;" />
                        </HBox>
                        <Label fx:id="lblTipoPenaError" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Total de Horas a Cumprir *" />
                        <TextField fx:id="txtHorasTotais" promptText="Ex: 160" />
                        <Label fx:id="lblHorasTotaisError" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Carga Horaria Semanal (Horas) *" />
                        <TextField fx:id="txtHorasSemanais" promptText="Ex: 8" />
                        <Label fx:id="lblHorasSemanaisError" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Data de Inicio *" />
                        <DatePicker fx:id="dpDataInicio" maxWidth="Infinity" />
                        <Label fx:id="lblDataInicioError" />
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label style="-fx-font-weight: 600; -fx-text-fill: #1e293b;" text="Data de Termino Estimada" />
                            <Button onAction="#handleCalcularEstimativa" style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;" text="⚡ Calcular" />
                        </HBox>
                        <DatePicker fx:id="dpDataTermino" maxWidth="Infinity" />
                        <Label fx:id="lblEstimativaTexto" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="" />
                    </VBox>

                    <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3" style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                        <Label style="-fx-font-weight: 700; -fx-text-fill: #1e293b; -fx-font-size: 13px;" text="📋 Contrato Inicial de Trabalho do Apenado (Jornada e Horários)" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Defina os dias da semana acordados e a carga horária diária que o apenado cumprirá na instituição." />

                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <Label style="-fx-font-weight: 600; -fx-text-fill: #334155;" text="Dias Acordados:" />
                            <CheckBox fx:id="chkSeg" text="Segunda" selected="true" />
                            <CheckBox fx:id="chkTer" text="Terça" selected="true" />
                            <CheckBox fx:id="chkQua" text="Quarta" selected="true" />
                            <CheckBox fx:id="chkQui" text="Quinta" selected="true" />
                            <CheckBox fx:id="chkSex" text="Sexta" selected="true" />
                            <CheckBox fx:id="chkSab" text="Sábado" />
                            <CheckBox fx:id="chkDom" text="Domingo" />
                        </HBox>

                        <GridPane hgap="14.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0" />
                                <ColumnConstraints percentWidth="50.0" />
                            </columnConstraints>
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label style="-fx-font-weight: 600; -fx-text-fill: #334155; -fx-font-size: 11px;" text="Carga Horária Diária Acordada (Horas/Dia)" />
                                <TextField fx:id="txtHorasDiarias" promptText="Ex: 4h por dia de comparecimento" text="4" />
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label style="-fx-font-weight: 600; -fx-text-fill: #334155; -fx-font-size: 11px;" text="Turno ou Horário de Atendimento Acordado" />
                                <TextField fx:id="txtTurnoAcordado" promptText="Ex: 08:00 às 12:00 (Matutino)" text="08:00 às 12:00" />
                            </VBox>
                        </GridPane>
                    </VBox>

                    <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                        <Label style="-fx-text-fill: #1e293b; -fx-font-weight: 600;" text="Atividades Acordadas e Observações do Contrato" />
                        <TextArea fx:id="txtAtividades" prefRowCount="3" promptText="Descrição detalhada das funções, regras da instituição e tarefas atribuídas..." />
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <Button fx:id="btnSalvarPena" onAction="#handleSalvarPena" prefHeight="40.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 24px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Salvar e Registrar Pena" />
                </HBox>
            </VBox>

            <VBox spacing="12.0" styleClass="card-container">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Penas e Contratos Cadastrados no Sistema" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Selecione uma pena na tabela abaixo para editar seus termos, dias de trabalho ou carga horária." />
                    </VBox>
                    <Button onAction="#handleRecarregarPenas" styleClass="btn-secondary" text="🔄 Atualizar Lista" style="-fx-font-size: 11px; -fx-padding: 6px 12px;" />
                    <Button fx:id="btnEditarPenaTabela" onAction="#handleEditarPenaSelecionada" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 6px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" text="✏️ Editar Contrato da Pena" />
                </HBox>

                <TableView fx:id="tblPenasGeral" prefHeight="260.0">
                    <columns>
                        <TableColumn fx:id="colPenaGeralId" prefWidth="55.0" text="ID" />
                        <TableColumn fx:id="colPenaGeralCodigo" prefWidth="85.0" text="Código" />
                        <TableColumn fx:id="colPenaGeralApenado" prefWidth="200.0" text="Apenado" />
                        <TableColumn fx:id="colPenaGeralTipo" prefWidth="180.0" text="Medida Alternativa" />
                        <TableColumn fx:id="colPenaGeralInstituicao" prefWidth="170.0" text="Instituição" />
                        <TableColumn fx:id="colPenaGeralHoras" prefWidth="75.0" text="Total" />
                        <TableColumn fx:id="colPenaGeralSemanais" prefWidth="75.0" text="Semanal" />
                        <TableColumn fx:id="colPenaGeralDias" prefWidth="190.0" text="Contrato / Dias Acordados" />
                        <TableColumn fx:id="colPenaGeralInicio" prefWidth="95.0" text="Início" />
                    </columns>
                    <placeholder>
                        <Label text="Nenhuma pena encontrada no sistema." style="-fx-text-fill: #94a3b8;" />
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
