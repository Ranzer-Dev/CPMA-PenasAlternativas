<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.TotemKioskController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
            </padding>

            <VBox alignment="CENTER" spacing="6.0">
                <Label style="-fx-font-size: 24px; -fx-font-weight: 900; -fx-text-fill: #2563eb;" text="CPMA - TERMINAL DE AUTOATENDIMENTO (TOTEM)" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Identificacao de apenados para registro de presenca e cumprimento de medidas alternativas." />
            </VBox>

            <HBox alignment="CENTER" maxWidth="560.0" spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 8px 16px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                <Label fx:id="lblTerminalInfo" style="-fx-font-weight: 700; -fx-text-fill: #1e293b; -fx-font-size: 12px;" text="Terminal: TOTEM_EXTERNO_01" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblStatusToken" styleClass="token-badge" text="Verificando Token..." />
                <Button fx:id="btnConfigurarToken" onAction="#handleConfigurarToken" style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-font-size: 11px; -fx-cursor: hand;" text="🔑 Token de Acesso" />
            </HBox>

            <TabPane fx:id="tabTotem" maxWidth="560.0" styleClass="card-container" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab text="📸 Reconhecimento Facial">
                        <VBox alignment="CENTER" spacing="16.0">
                            <padding>
                                <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
                            </padding>

                            <StackPane prefHeight="240.0" prefWidth="380.0" styleClass="camera-preview-box">
                                <ImageView fx:id="imgCameraPreview" fitHeight="230.0" fitWidth="360.0" pickOnBounds="true" preserveRatio="true" />
                                <Label fx:id="lblCameraPlaceholder" alignment="CENTER" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: 600;" text="📸 Nenhuma imagem carregada&#10;Clique abaixo para capturar ou selecionar" textAlignment="CENTER" />
                            </StackPane>

                            <HBox alignment="CENTER" spacing="12.0">
                                <Button fx:id="btnCarregarFoto" onAction="#handleCarregarFoto" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-text-fill: #1e293b; -fx-font-weight: 600; -fx-padding: 8px 16px; -fx-cursor: hand;" text="📁 Selecionar Foto da Face" />
                                <Button fx:id="btnFotoExemplo" onAction="#handleCarregarFotoExemplo" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: 600; -fx-padding: 8px 14px; -fx-background-radius: 6px; -fx-cursor: hand;" text="⚡ Foto Padrao" />
                            </HBox>

                            <Label fx:id="lblBiometriaFeedback" visible="false" wrapText="true" maxWidth="Infinity" />

                            <Button fx:id="btnIdentificarFacial" maxWidth="Infinity" onAction="#handleIdentificarFacial" prefHeight="42.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 14px; -fx-background-radius: 6px; -fx-cursor: hand;" text="🔍 Confirmar Presenca por Reconhecimento Facial" />
                        </VBox>
                    </Tab>

                    <Tab text="🔢 Codigo de Acesso">
                        <VBox alignment="CENTER" spacing="16.0">
                            <padding>
                                <Insets bottom="20.0" left="16.0" right="16.0" top="20.0" />
                            </padding>

                            <Label style="-fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Digite o codigo de 6 digitos emitido para o apenado:" />
                            <TextField fx:id="txtCodigoAcesso" alignment="CENTER" maxWidth="320.0" promptText="000000" style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-letter-spacing: 4px;" />
                            <Button fx:id="btnConfirmarCodigo" maxWidth="320.0" onAction="#handleValidarCodigo" prefHeight="42.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 14px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Confirmar Presenca com Codigo" />
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>

            <VBox fx:id="cardResultado" alignment="CENTER" maxWidth="560.0" spacing="14.0" styleClass="card-container" visible="false" managed="false">
                <Label fx:id="lblResultadoTitulo" style="-fx-font-size: 17px; -fx-font-weight: 800;" />
                <Label fx:id="lblResultadoDetalhe" style="-fx-text-fill: #1e293b; -fx-font-size: 13px;" textAlignment="CENTER" wrapText="true" />

                <VBox fx:id="boxResumoTotem" spacing="8.0" style="-fx-background-color: #f8fafc; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" visible="false" managed="false">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-font-size: 13px;" text="Resumo de Horas da Medida:" />
                    <GridPane hgap="12.0" vgap="6.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" />
                            <ColumnConstraints percentWidth="50.0" />
                        </columnConstraints>
                        <Label fx:id="lblTotemHorasCumpridas" style="-fx-font-weight: 600; -fx-text-fill: #059669;" text="Cumpridas: 0h" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblTotemHorasRestantes" style="-fx-font-weight: 600; -fx-text-fill: #dc2626;" text="Restantes: 0h" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label fx:id="lblTotemHorasTotais" style="-fx-text-fill: #64748b;" text="Total Pena: 0h" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblTotemPercentual" style="-fx-text-fill: #64748b;" text="Progresso: 0%" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </GridPane>
                </VBox>

                <HBox fx:id="boxAcoesTotem" alignment="CENTER" spacing="12.0" visible="false" managed="false">
                    <Button fx:id="btnImprimirComprovante" onAction="#handleImprimirComprovante" prefHeight="38.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" text="🖨️ Imprimir Comprovante de Presenca" />
                    <Button onAction="#handleNovoAcesso" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8px 16px; -fx-cursor: hand;" text="Concluir Atendimento" />
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
