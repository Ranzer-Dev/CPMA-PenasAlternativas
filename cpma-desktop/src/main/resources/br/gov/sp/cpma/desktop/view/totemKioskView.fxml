<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="24.0" style="-fx-background-color: #f8fafc;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.TotemKioskController">
    <padding>
        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
    </padding>

    <Label style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #2563eb;" text="CPMA - TERMINAL DE IDENTIFICACAO" />
    <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Posicione-se em frente a camera ou digite seu codigo de acesso de 6 digitos." />

    <VBox maxWidth="480.0" spacing="16.0" styleClass="card-container">
        <Label text="Digitar Codigo de Acesso:" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1e293b;" />
        <TextField fx:id="txtCodigoAcesso" alignment="CENTER" promptText="000000" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-letter-spacing: 4px;" />
        <Button fx:id="btnConfirmarCodigo" maxWidth="Infinity" onAction="#handleValidarCodigo" text="Confirmar Presenca" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: 800; -fx-font-size: 15px; -fx-padding: 10px; -fx-background-radius: 6px; -fx-cursor: hand;" />
    </VBox>

    <VBox fx:id="cardResultado" maxWidth="480.0" alignment="CENTER" spacing="12.0" visible="false" managed="false">
        <Label fx:id="lblResultadoTitulo" style="-fx-font-size: 18px; -fx-font-weight: 800;" />
        <Label fx:id="lblResultadoDetalhe" wrapText="true" textAlignment="CENTER" style="-fx-text-fill: #1e293b; -fx-font-size: 14px;" />

        <VBox fx:id="boxResumoTotem" spacing="8.0" style="-fx-background-color: #ffffff; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;" visible="false" managed="false">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #2563eb; -fx-font-size: 13px;" text="Resumo de Horas da Medida:" />
            <GridPane hgap="12.0" vgap="4.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0" />
                    <ColumnConstraints percentWidth="50.0" />
                </columnConstraints>
                <Label fx:id="lblTotemHorasCumpridas" style="-fx-font-weight: 600; -fx-text-fill: #059669;" text="Cumpridas: 0h" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="lblTotemHorasRestantes" style="-fx-font-weight: 600; -fx-text-fill: #dc2626;" text="Restantes: 0h" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label fx:id="lblTotemHorasTotais" style="-fx-text-fill: #64748b;" text="Total Pena: 0h" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="lblTotemPercentual" style="-fx-text-fill: #64748b;" text="Progresso: 0%" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>
        </VBox>

        <HBox fx:id="boxAcoesTotem" alignment="CENTER" spacing="12.0" visible="false" managed="false">
            <Button fx:id="btnImprimirComprovante" onAction="#handleImprimirComprovante" prefHeight="40.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" text="🖨️ Imprimir Dados e Trabalho" />
            <Button onAction="#handleNovoAcesso" prefHeight="40.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8px 16px; -fx-background-radius: 6px; -fx-cursor: hand;" text="Concluir" />
        </HBox>
    </VBox>
</VBox>
