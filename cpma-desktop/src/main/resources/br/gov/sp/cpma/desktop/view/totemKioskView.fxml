<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.gov.sp.cpma.desktop.controller.TotemKioskController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f8fafc;">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
            </padding>

            <VBox alignment="CENTER" spacing="6.0">
                <Label style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #1e3a8a;" text="CPMA - TERMINAL DE AUTOATENDIMENTO (TOTEM)" />
                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Registro Oficial de Presenca e Acompanhamento de Medidas Alternativas" />
            </VBox>

            <HBox alignment="CENTER" maxWidth="520.0" spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 10px 18px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);">
                <Label fx:id="lblTerminalInfo" style="-fx-font-weight: 700; -fx-text-fill: #1e293b; -fx-font-size: 13px;" text="Terminal: TOTEM_EXTERNO_01" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblStatusToken" style="-fx-background-color: rgba(16, 185, 129, 0.15); -fx-text-fill: #059669; -fx-font-weight: 700; -fx-padding: 4px 12px; -fx-background-radius: 12px; -fx-font-size: 12px;" text="● Sistema Online" />
            </HBox>

            <VBox fx:id="cardEntradaCodigo" alignment="CENTER" maxWidth="520.0" spacing="18.0" styleClass="card-container">
                <VBox alignment="CENTER" spacing="6.0">
                    <Label style="-fx-font-size: 19px; -fx-font-weight: 800; -fx-text-fill: #0f172a;" text="Digite seu Código de Acesso" />
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-text-alignment: center;" text="Informe o código numérico de 6 dígitos gerado durante o seu atendimento presencial." wrapText="true" />
                </VBox>

                <TextField fx:id="txtCodigoAcesso" alignment="CENTER" editable="true" maxWidth="340.0" promptText="000000" style="-fx-font-size: 32px; -fx-font-weight: 900; -fx-text-fill: #1e3a8a; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-border-color: #3b82f6; -fx-border-width: 2px; -fx-padding: 8px 16px;" />

                <GridPane alignment="CENTER" hgap="12.0" maxWidth="340.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" percentWidth="33.33" />
                        <ColumnConstraints halignment="CENTER" percentWidth="33.33" />
                        <ColumnConstraints halignment="CENTER" percentWidth="33.33" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="54.0" />
                        <RowConstraints minHeight="54.0" />
                        <RowConstraints minHeight="54.0" />
                        <RowConstraints minHeight="54.0" />
                    </rowConstraints>

                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="3" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="7" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="8" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="9" GridPane.columnIndex="2" GridPane.rowIndex="2" />

                    <Button onAction="#handleTecladoLimpar" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 15px; -fx-font-weight: 800; -fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 8px; -fx-cursor: hand;" text="LIMPAR" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Button onAction="#handleTecladoDigito" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #1e293b; -fx-background-radius: 8px; -fx-cursor: hand;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <Button onAction="#handleTecladoApagar" prefHeight="54.0" prefWidth="100.0" style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8px; -fx-cursor: hand;" text="⌫" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                </GridPane>

                <Button fx:id="btnConfirmarCodigo" maxWidth="340.0" onAction="#handleValidarCodigo" prefHeight="50.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 15px; -fx-background-radius: 8px; -fx-cursor: hand;" text="Confirmar Presença" />
            </VBox>

            <VBox fx:id="cardResultado" alignment="CENTER" maxWidth="520.0" spacing="16.0" styleClass="card-container" visible="false" managed="false">
                <Label fx:id="lblResultadoTitulo" style="-fx-font-size: 18px; -fx-font-weight: 900;" />
                <Label fx:id="lblResultadoDetalhe" style="-fx-text-fill: #1e293b; -fx-font-size: 14px;" textAlignment="CENTER" wrapText="true" />

                <VBox fx:id="boxResumoTotem" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 16px; -fx-background-radius: 10px; -fx-border-color: #e2e8f0; -fx-border-radius: 10px;" visible="false" managed="false">
                    <Label style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 14px;" text="Resumo da Medida Alternativa:" />
                    <GridPane hgap="16.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" />
                            <ColumnConstraints percentWidth="50.0" />
                        </columnConstraints>
                        <Label fx:id="lblTotemHorasCumpridas" style="-fx-font-weight: 700; -fx-text-fill: #059669; -fx-font-size: 13px;" text="Cumpridas: 0h" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblTotemHorasRestantes" style="-fx-font-weight: 700; -fx-text-fill: #dc2626; -fx-font-size: 13px;" text="Restantes: 0h" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label fx:id="lblTotemHorasTotais" style="-fx-text-fill: #475569; -fx-font-size: 13px;" text="Total Pena: 0h" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblTotemPercentual" style="-fx-text-fill: #2563eb; -fx-font-weight: 700; -fx-font-size: 13px;" text="Progresso: 0%" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </GridPane>
                </VBox>

                <HBox fx:id="boxAcoesTotem" alignment="CENTER" spacing="14.0" visible="false" managed="false">
                    <Button fx:id="btnImprimirComprovante" onAction="#handleImprimirComprovante" prefHeight="42.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8px 18px; -fx-background-radius: 8px; -fx-cursor: hand;" text="🖨️ Imprimir Comprovante" />
                    <Button onAction="#handleNovoAcesso" prefHeight="42.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8px 18px; -fx-cursor: hand;" text="Concluir Atendimento" />
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
